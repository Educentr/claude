#!/usr/bin/env node
// Stands in for the Codex CLI in the transport test: records how it was called, answers from stdin.
const fs = require('node:fs');
const args = process.argv.slice(2);
if (args[0] === '--version') { console.log('codex-cli 0.0.0-fake'); process.exit(0); }
if (args[0] === 'login') process.exit(0);
const out = args[args.indexOf('-o') + 1];
const prompt = fs.readFileSync(0, 'utf8');
fs.appendFileSync(process.env.FAKE_CODEX_CALLS, JSON.stringify({ args, cwd: args[args.indexOf('-C') + 1], prompt }) + '\n');
console.log(JSON.stringify({ type: 'thread.started', thread_id: 'thread-fake-1' }));
if (prompt.includes('PLEASE_HANG')) setTimeout(() => {}, 600000);
else if (prompt.includes('PLEASE_FAIL')) { fs.writeFileSync(out, 'half an answer'); process.exit(3); }
else if (prompt.includes('PLEASE_BE_HUGE')) fs.writeFileSync(out, 'x'.repeat(300 * 1024));
else fs.writeFileSync(out, 'VERDICT: APPROVE\nREVIEWED_HEAD: ' + (prompt.match(/Head: (\w+)/)?.[1] ?? 'none') + '\n\nBLOCKING\nNone.\n');
